venv/
# Anchored: a bare "audio/" matches any directory of that name at any
# depth, which silently excluded assets/audio/ — a bundled resource. The
# rule is meant for the user's music library at the repo root.
/audio/
__pycache/
.DS_Store
./audio/
./venv/


# Security and Data
.env
*.log
*.sqlite
# Ignore folders anywhere in the directory tree
**/__pycache__/
venv/
/audio/
data/

# Ignore specific file types anywhere
*.py[cod]
*$py.class
*.db
*.json
!themes/
!themes/*.json
# Bundled editorial config that ships with the package (not runtime/user data).
!src/getmoredone/email_cleaning_rules.json
# Editorial config read by the repo guards. Untracked, it is absent on CI, where
# the guard that reads it raises rather than reporting a clean document.
!tools/agents/retired_vocabulary.json
.DS_Store

# Ignore specific duplicate/temp files
.gitignore copy

# PyInstaller
/build/
/dist/
.pip-cache/

# Scratch dir written and removed by
# tests/test_ci_contract.py::test_the_mapped_window_opt_out_is_off_by_default.
# Listed so a killed run cannot leave it in a commit.
.gmd-optout-probe/
